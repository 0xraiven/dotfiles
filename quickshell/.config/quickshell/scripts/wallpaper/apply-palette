#!/usr/bin/env bash
set -euo pipefail

WALLPAPER="${1:-}"
MATUGEN_CONFIG="${MATUGEN_CONFIG:-${HOME}/.config/matugen/config.toml}"

if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
  echo "Usage: apply-palette /path/to/wallpaper" >&2
  exit 2
fi

if ! command -v matugen >/dev/null 2>&1; then
  echo "matugen is not installed; skipping palette generation" >&2
  exit 0
fi

matugen image \
  --config "$MATUGEN_CONFIG" \
  --mode dark \
  --type scheme-tonal-spot \
  --source-color-index 0 \
  --quiet \
  "$WALLPAPER"

REPO_DIR="${DOTFILES_REPO_DIR:-${HOME}/git/dotfiles}"
if [ -d "$REPO_DIR/quickshell/.config/quickshell/launcher" ]; then
  cp -f "${HOME}/.config/quickshell/launcher/Colors.qml" "$REPO_DIR/quickshell/.config/quickshell/launcher/Colors.qml" 2>/dev/null || true
fi

if command -v pkill >/dev/null 2>&1; then
  pkill --signal USR2 --exact waybar 2>/dev/null || true
fi

if command -v hyprctl >/dev/null 2>&1; then
  colors_file="${HOME}/.config/hypr/config/colors.lua"
  if [ -f "$colors_file" ]; then
    primary="$(grep -Po 'primary\s*=\s*"\K[^"]*' "$colors_file" 2>/dev/null || true)"
    surface_variant="$(grep -Po 'surface_variant\s*=\s*"\K[^"]*' "$colors_file" 2>/dev/null || true)"
    if [ -n "$primary" ] && [ -n "$surface_variant" ]; then
      active_col="0xff${primary#\#}ff"
      inactive_col="0xff${surface_variant#\#}ff"
      hyprctl eval "hl.config({ general = { col = { active_border = '$active_col', inactive_border = '$inactive_col' } } })" >/dev/null 2>&1 || true
    fi
  fi
fi
