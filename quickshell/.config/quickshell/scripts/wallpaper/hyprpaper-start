#!/usr/bin/env bash
set -euo pipefail

LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-hyprpaper.lock"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if pgrep -x hyprpaper >/dev/null 2>&1; then
  exit 0
fi

# Apply initial wallpaper once hyprpaper is ready (wallpaper-next has built-in retry)
(
  sleep 0.5
  "$SCRIPT_DIR/wallpaper-next" >/dev/null 2>&1 || true
) &

exec flock --nonblock "$LOCK_FILE" hyprpaper "$@"
