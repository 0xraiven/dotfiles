#!/usr/bin/env bash
set -euo pipefail

LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-hyprpaper.lock"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if pgrep -x hyprpaper >/dev/null 2>&1; then
  exit 0
fi

(
  # Wait for hyprpaper to initialize and set the initial wallpaper
  for _ in {1..40}; do
    if hyprctl hyprpaper listloaded >/dev/null 2>&1 || [ -S "${XDG_RUNTIME_DIR:-/tmp}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.hyprpaper.sock" ]; then
      "$SCRIPT_DIR/wallpaper-next" >/dev/null 2>&1 || true
      break
    fi
    sleep 0.1
  done
) &

exec flock --nonblock "$LOCK_FILE" hyprpaper "$@"
