#!/usr/bin/env bash
set -euo pipefail

work_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
"$SCRIPT_DIR/launcher-items" > "$work_dir/apps.json"

# Build ONLY custom environment commands & desktop controls
python3 -c "
import json, os, glob

wallpapers_dir = os.path.expanduser('~/Pictures/Wallpapers')
wp_scripts = os.path.expanduser('~/.config/quickshell/scripts/wallpaper')
sys_scripts = os.path.expanduser('~/.config/quickshell/scripts/system')

cmds = [
    {
        'id': '@',
        'name': 'Wallpaper Picker',
        'subtitle': 'Browse and preview wallpapers in Spotlight',
        'kind': 'command'
    },
    {
        'id': f'{wp_scripts}/wallpaper-next',
        'name': 'Next Wallpaper',
        'subtitle': 'Cycle to next wallpaper & update theme',
        'kind': 'command'
    },
    {
        'id': f'{wp_scripts}/wallpaper-random',
        'name': 'Random Wallpaper',
        'subtitle': 'Select random wallpaper & update theme',
        'kind': 'command'
    },
]

# Custom desktop controls
cmds.extend([
    {
        'id': f'{sys_scripts}/screenshot region',
        'name': 'Screenshot (Select Region)',
        'subtitle': 'Save cropped screenshot to Pictures & clipboard',
        'kind': 'command'
    },
    {
        'id': f'{sys_scripts}/screenshot full',
        'name': 'Screenshot (Full Screen)',
        'subtitle': 'Save full desktop capture to Pictures & clipboard',
        'kind': 'command'
    },
    {
        'id': 'hyprctl reload',
        'name': 'Reload Hyprland',
        'subtitle': 'Reload Hyprland window manager configuration',
        'kind': 'command'
    },
    {
        'id': f'{sys_scripts}/waybar-start',
        'name': 'Restart Waybar',
        'subtitle': 'Restart top bar and reload styling',
        'kind': 'command'
    },
    {
        'id': f'{sys_scripts}/power-profile-cycle',
        'name': 'Cycle Power Profile',
        'subtitle': 'Switch Performance / Balanced / Power Saver modes',
        'kind': 'command'
    },
    {
        'id': 'loginctl lock-session',
        'name': 'Lock Screen',
        'subtitle': 'Lock the current desktop session',
        'kind': 'command'
    },
    {
        'id': 'systemctl suspend',
        'name': 'Suspend System',
        'subtitle': 'Put computer into low-power sleep state',
        'kind': 'command'
    },
    {
        'id': 'systemctl reboot',
        'name': 'Reboot System',
        'subtitle': 'Restart the computer',
        'kind': 'command'
    },
    {
        'id': 'systemctl poweroff',
        'name': 'Shut Down',
        'subtitle': 'Safely power off computer',
        'kind': 'command'
    }
])

with open('$work_dir/commands.json', 'w') as f:
    json.dump(cmds, f)
"

find "$HOME" \
  -type d \( \
    -path "$HOME/.cache" \
    -o -path "$HOME/.local/share/Trash" \
    -o -path '*/.git' \
    -o -path '*/target' \
  \) -prune \
  -o -type f -print 2>/dev/null | sort -f | \
  jq -Rsc 'split("\n") | map(select(length > 0) | {id: ., name: (split("/") | last), subtitle: ., kind: "file"}) | .[0:5000]' \
  > "$work_dir/files.json"

jq -cn \
  --slurpfile apps "$work_dir/apps.json" \
  --slurpfile commands "$work_dir/commands.json" \
  --slurpfile files "$work_dir/files.json" \
  '$apps[0] | map(. + {kind: "app", subtitle: "Application"}) + $commands[0] + $files[0]'
