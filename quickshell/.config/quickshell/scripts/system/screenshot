#!/usr/bin/env bash
set -euo pipefail

mode="${1:-region}"
pictures_dir="${XDG_PICTURES_DIR:-$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")}"
screenshots_dir="$pictures_dir/Screenshots"
timestamp="$(date +%Y%m%d-%H%M%S)"
output_file="$screenshots_dir/screenshot-$timestamp.png"

mkdir -p "$screenshots_dir"

case "$mode" in
  region)
    geometry="$(slurp)"
    [ -n "$geometry" ] || exit 0
    grim -g "$geometry" "$output_file"
    ;;
  full)
    grim "$output_file"
    ;;
  *)
    echo "Usage: screenshot [region|full]" >&2
    exit 2
    ;;
esac

wl-copy --type image/png < "$output_file"
printf '%s\n' "$output_file"
