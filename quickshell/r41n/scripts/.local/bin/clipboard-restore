#!/usr/bin/env bash
set -euo pipefail

entry_id="${1:-}"
if [ -z "$entry_id" ]; then
  echo "Usage: clipboard-restore ENTRY_ID" >&2
  exit 2
fi

selection="$(cliphist list | awk -v id="$entry_id" '$1 == id { sub(/^[^[:space:]]+[[:space:]]+/, ""); print; exit }')"
if [ -z "$selection" ]; then
  echo "Clipboard entry not found: $entry_id" >&2
  exit 1
fi

entry_file="$(mktemp)"
cleanup() {
  rm -f "$entry_file"
}
trap cleanup EXIT

printf '%s\t%s\n' "$entry_id" "$selection" | cliphist decode > "$entry_file"
mime_type="$(file --brief --mime-type "$entry_file")"

case "$mime_type" in
  image/*)
    wl-copy --type "$mime_type" < "$entry_file"
    ;;
  *)
    wl-copy < "$entry_file"
    ;;
esac
