#!/usr/bin/env bash
set -euo pipefail

selection="$(cliphist list | wofi --dmenu --prompt 'Clipboard' --normal-window)"

if [ -z "$selection" ]; then
  exit 0
fi

entry_file="$(mktemp)"
cleanup() {
  rm -f "$entry_file"
}
trap cleanup EXIT

cliphist decode <<< "$selection" > "$entry_file"
mime_type="$(file --brief --mime-type "$entry_file")"

case "$mime_type" in
  image/*)
    wl-copy --type "$mime_type" < "$entry_file"
    ;;
  *)
    wl-copy < "$entry_file"
    ;;
esac
